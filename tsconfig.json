{
  "compilerOptions": {
    /* Language & Runtime */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,

    /* JS interoperability */
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Type Safety (fase 1) */
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
